test("modeChangeState changes setup mode but blocks active runs", () => {
  assert.deepEqual(core.modeChangeState({
    mode: "survival",
    isGameActive: false,
  }, "rush", core.gameModes), {
    mode: "rush",
    timeLeft: 60,
    lives: 3,
    changed: true,
  });
  assert.deepEqual(core.modeChangeState({
    mode: "survival",
    isGameActive: true,
    timeLeft: null,
    lives: 5,
  }, "rush", core.gameModes), {
    mode: "survival",
    timeLeft: null,
    lives: 5,
    changed: false,
  });
  assert.deepEqual(core.modeChangeState({
    mode: "rush",
    isGameActive: false,
  }, "unknown", core.gameModes), {
    mode: "rush",
    timeLeft: 60,
    lives: 3,
    changed: false,
  });
});

test("finishRunState clears transient gameplay state without touching score fields", () => {
  assert.deepEqual(core.finishRunState(1280, 720), {
    isGameActive: false,
    isPaused: false,
    countdownRemaining: null,
    objects: [],
    particles: [],
    splashes: [],
    trails: [],
    floatingTexts: [],
    spawnTimeouts: [],
    fingerTip: { x: 0.5, y: 0.5, z: 0 },
    prevFingerTip: { x: 0.5, y: 0.5, z: 0 },
    fingerScreen: { x: 640, y: 360 },
    prevFingerScreen: { x: 640, y: 360 },
    handLandmarks: null,
    inputReady: false,
  });
});
