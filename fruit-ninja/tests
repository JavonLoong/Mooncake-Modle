import assert from "node:assert/strict";
import { createRequire } from "node:module";
import test from "node:test";

const require = createRequire(import.meta.url);
const core = require("../game-core.js");

test("mode config exposes survival, rush, and focus rules", () => {
  assert.equal(core.gameModes.survival.lives, 5);
  assert.equal(core.gameModes.rush.duration, 60);
  assert.equal(core.gameModes.focus.bombBase, 0);
});

test("formatTime shows infinity for untimed modes and rounds active timers up", () => {
  assert.equal(core.formatTime(null), "∞");
  assert.equal(core.formatTime(0), "0");
  assert.equal(core.formatTime(12.01), "13");
});

test("HUD formatters keep invalid timer and lives values out of the display", () => {
  assert.equal(core.formatTime(Number.NaN), "0");
  assert.equal(core.formatTime(-4.2), "0");
  assert.equal(core.formatLives("survival", Number.NaN), "0");
  assert.equal(core.formatLives("survival", -3), "0");
  assert.equal(core.formatLives("survival", 2.8), "2");
  assert.equal(core.formatLives("focus", Number.NaN), "∞");
});

test("calculateWaveSize grows with time and score but stays capped", () => {
  assert.equal(core.calculateWaveSize(core.gameModes.survival, 0, 0, 0), 1);
  assert.equal(core.calculateWaveSize(core.gameModes.survival, 40, 60, 0), 5);
  assert.equal(core.calculateWaveSize(core.gameModes.rush, 20, 0, 0.7), 4);
});

test("difficulty helpers ignore negative progress inputs", () => {
  assert.equal(core.calculateWaveSize(core.gameModes.survival, -40, -20, 0), 1);
  assert.equal(core.nextSpawnInterval(core.gameModes.survival, -30), core.gameModes.survival.spawnBase);
  assert.equal(core.bombChance(core.gameModes.survival, -30), core.gameModes.survival.bombBase);
});

test("calculateSliceReward multiplies fruit value by combo", () => {
  assert.equal(core.calculateSliceReward({ score: 2 }, 1), 2);
  assert.equal(core.calculateSliceReward({ score: 2 }, 4), 8);
});

test("calculateSliceReward guards invalid fruit values and combo counts", () => {
  assert.equal(core.calculateSliceReward({}, Number.NaN), 1);
  assert.equal(core.calculateSliceReward({ score: -3 }, 4), 4);
  assert.equal(core.calculateSliceReward({ score: 2 }, -6), 2);
});

test("nextSpawnInterval tightens over time without crossing the mode floor", () => {
  assert.equal(core.nextSpawnInterval(core.gameModes.rush, 0), 760);
  assert.equal(core.nextSpawnInterval(core.gameModes.rush, 1000), 300);
});

test("smoothPoint interpolates without mutating the source points", () => {
  const previous = { x: 0.2, y: 0.4, z: 0 };
  const next = { x: 0.8, y: 0.2, z: -0.4 };
  const smoothed = core.smoothPoint(previous, next, 0.25);
  assert.deepEqual(smoothed, { x: 0.35, y: 0.35, z: -0.1 });
  assert.deepEqual(previous, { x: 0.2, y: 0.4, z: 0 });
});

test("nextCombo increments inside the combo window and resets outside it", () => {
  assert.equal(core.nextCombo(1, 200), 2);
  assert.equal(core.nextCombo(8, 200), 8);
  assert.equal(core.nextCombo(5, 900), 1);
});

test("nextCombo normalizes invalid combo state", () => {
  assert.equal(core.nextCombo(Number.NaN, 200), 2);
  assert.equal(core.nextCombo(-4, 200), 2);
  assert.equal(core.nextCombo(20, 200), 8);
});

test("best score keys are scoped by mode", () => {
  assert.equal(core.bestScoreKey("survival"), "hand-slice-best-survival");
  assert.equal(core.bestScoreKey("rush"), "hand-slice-best-rush");
});

test("updateBestScore only replaces lower best scores", () => {
  assert.equal(core.updateBestScore(42, 17), 42);
  assert.equal(core.updateBestScore(42, 80), 80);
});

test("updateBestScore ignores invalid and negative values", () => {
  assert.equal(core.updateBestScore(Number.NaN, 12), 12);
  assert.equal(core.updateBestScore(18, Number.NaN), 18);
  assert.equal(core.updateBestScore(-5, -2), 0);
});

test("storedScoreValue parses persisted score strings safely", () => {
  assert.equal(core.storedScoreValue("37"), 37);
  assert.equal(core.storedScoreValue("12.8"), 12);
  assert.equal(core.storedScoreValue("bad-data"), 0);
  assert.equal(core.storedScoreValue(null), 0);
  assert.equal(core.storedScoreValue("-99"), 0);
});

test("togglePause changes state only while a game is active", () => {
  assert.deepEqual(core.togglePause({ isGameActive: true, isPaused: false }), {
    isGameActive: true,
    isPaused: true,
  });
  assert.deepEqual(core.togglePause({ isGameActive: false, isPaused: false }), {
    isGameActive: false,
    isPaused: false,
  });
});

test("cameraConstraints select lower capture size on mobile", () => {
  assert.deepEqual(core.cameraConstraints(false), {
    video: { width: { ideal: 640 }, height: { ideal: 360 }, facingMode: "user" },
    audio: false,
  });
  assert.deepEqual(core.cameraConstraints(true), {
    video: { width: { ideal: 360 }, height: { ideal: 240 }, facingMode: "user" },
    audio: false,
  });
});

test("advanceTimedMode clamps timers and reports when a timed mode ends", () => {
  assert.deepEqual(core.advanceTimedMode(null, 10), { timeLeft: null, shouldEnd: false });
  assert.deepEqual(core.advanceTimedMode(3, 0.5), { timeLeft: 2.5, shouldEnd: false });
  assert.deepEqual(core.advanceTimedMode(0.2, 1), { timeLeft: 0, shouldEnd: true });
});

test("frameDeltas keeps real clock time while capping physics time", () => {
  assert.deepEqual(core.frameDeltas(1000, 2500), { clockDelta: 1.5, physicsDelta: 0.04 });
  assert.deepEqual(core.frameDeltas(2500, 2516), { clockDelta: 0.016, physicsDelta: 0.016 });
  assert.deepEqual(core.frameDeltas(3000, 2500), { clockDelta: 0, physicsDelta: 0 });
});

test("resolveLifePenalty applies mode-specific miss and bomb rules", () => {
  assert.deepEqual(core.resolveLifePenalty(core.gameModes.survival, 5, "miss"), {
    lives: 4,
    penalty: 1,
    shouldEnd: false,
  });
  assert.deepEqual(core.resolveLifePenalty(core.gameModes.survival, 1, "bomb"), {
    lives: 0,
    penalty: 1,
    shouldEnd: true,
  });
  assert.deepEqual(core.resolveLifePenalty(core.gameModes.rush, 3, "miss"), {
    lives: 3,
    penalty: 0,
    shouldEnd: false,
  });
  assert.deepEqual(core.resolveLifePenalty(core.gameModes.rush, 0, "miss"), {
    lives: 0,
    penalty: 0,
    shouldEnd: false,
  });
  assert.deepEqual(core.resolveLifePenalty(core.gameModes.focus, 0, "bomb"), {
    lives: 0,
    penalty: 0,
    shouldEnd: false,
  });
});

test("countdownLabel maps countdown seconds to clear launch text", () => {
  assert.equal(core.countdownLabel(2.9), "3");
  assert.equal(core.countdownLabel(1.5), "2");
  assert.equal(core.countdownLabel(0.4), "1");
  assert.equal(core.countdownLabel(0), "GO");
});

test("scoreRank gives stronger labels as score increases", () => {
  assert.deepEqual(core.scoreRank(0), { label: "懵懂菜鸟", nextAt: 25 });
  assert.deepEqual(core.scoreRank(40), { label: "武者学徒", nextAt: 75 });
  assert.deepEqual(core.scoreRank(95), { label: "刀锋大师", nextAt: 150 });
  assert.deepEqual(core.scoreRank(200), { label: "传奇忍者", nextAt: null });
});

test("canSpawnObject blocks inactive, paused, and countdown states", () => {
  assert.equal(core.canSpawnObject({ isGameActive: false, isPaused: false, countdownRemaining: null }), false);
  assert.equal(core.canSpawnObject({ isGameActive: true, isPaused: true, countdownRemaining: null }), false);
  assert.equal(core.canSpawnObject({ isGameActive: true, isPaused: false, countdownRemaining: 1 }), false);
  assert.equal(core.canSpawnObject({ isGameActive: true, isPaused: false, countdownRemaining: null }), true);
});

test("sliceHitRadius caps noisy tracking jumps", () => {
  assert.equal(core.sliceHitRadius(1.2, 0.05), 2.336);
  assert.equal(core.sliceHitRadius(1.2, 12), 7.136);
  assert.equal(core.sliceHitRadius(-1, Number.NaN), 1.28);
});

test("initialInputState centers normalized and screen coordinates", () => {
  assert.deepEqual(core.initialInputState(1280, 720), {
    fingerTip: { x: 0.5, y: 0.5, z: 0 },
    prevFingerTip: { x: 0.5, y: 0.5, z: 0 },
    fingerScreen: { x: 640, y: 360 },
    prevFingerScreen: { x: 640, y: 360 },
    handLandmarks: null,
    inputReady: false,
  });
});

test("initialInputState guards invalid viewport dimensions", () => {
  assert.deepEqual(core.initialInputState(0, undefined).fingerScreen, { x: 0.5, y: 0.5 });
  assert.deepEqual(core.initialInputState(Number.NaN, -20).prevFingerScreen, { x: 0.5, y: 0.5 });
});

test("sanitizeInputPoint clamps coordinates and fills missing depth", () => {
  assert.deepEqual(core.sanitizeInputPoint({ x: -0.25, y: 1.4 }), { x: 0, y: 1, z: 0 });
  assert.deepEqual(core.sanitizeInputPoint({ x: 0.25, y: 0.75, z: -0.4 }), { x: 0.25, y: 0.75, z: -0.4 });
  assert.deepEqual(core.sanitizeInputPoint({ x: Number.NaN, y: undefined, z: Number.NaN }), { x: 0.5, y: 0.5, z: 0 });
});

test("camera landmarks are mapped into mirrored selfie screen coordinates", () => {
  assert.deepEqual(core.cameraLandmarkToScreenPoint({ x: 0.2, y: 0.35, z: -0.1 }), {
    x: 0.8,
    y: 0.35,
    z: -0.1,
  });
  assert.deepEqual(core.cameraLandmarkToScreenPoint({ x: -0.2, y: 1.4, z: Number.NaN }), {
    x: 1,
    y: 1,
    z: 0,
  });
});

test("camera landmark arrays map to screen coordinates without mutating source landmarks", () => {
  const landmarks = [
    { x: 0.1, y: 0.2, z: 0 },
    { x: 0.9, y: 0.8, z: -0.2 },
  ];

  assert.deepEqual(core.cameraLandmarksToScreenPoints(landmarks), [
    { x: 0.9, y: 0.2, z: 0 },
    { x: 0.1, y: 0.8, z: -0.2 },
  ]);
  assert.deepEqual(landmarks, [
    { x: 0.1, y: 0.2, z: 0 },
    { x: 0.9, y: 0.8, z: -0.2 },
  ]);
});

